{
	"name": "verturin/portfolio",
	"type": "phpbb-extension",
	"description": "Modern photo gallery for phpBB: personal and public albums with sub-albums, shared albums, ratings, reactions, comments, traceable watermark, recycle bin, per-group quotas and approval, notifications, [portfolio] BBCode and migration from phpBB Gallery.",
	"homepage": "https://github.com/verturin/portfolio",
	"version": "1.10.13",
	"time": "2026-10-21",
	"keywords": ["phpbb", "extension", "gallery", "portfolio", "photos", "albums", "watermark"],
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "verturin",
			"homepage": "https://github.com/verturin",
			"role": "Lead Developer"
		}
	],
	"require": {
		"php": ">=7.2.0",
		"ext-gd": "*",
		"composer/installers": "~1.0"
	},
	"extra": {
		"display-name": "Portfolio",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.15,<5.0.0@dev"
		},
		"version-check": {
			"host": "raw.githubusercontent.com",
			"directory": "/verturin/portfolio/main",
			"filename": "version.json",
			"ssl": true
		}
	}
}
