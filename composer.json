{
	"name": "verturin/portfolio",
	"type": "phpbb-extension",
	"description": "Portfolio — galerie photos moderne pour phpBB : albums et sous-albums, albums partagés entre membres, notation, commentaires, corbeille avec validation par l'administrateur, suppression EXIF et droits par groupe sur toutes les fonctions.",
	"homepage": "https://github.com/verturin/portfolio",
	"version": "1.10.8",
	"time": "2026-10-09",
	"keywords": ["phpbb", "extension", "gallery", "portfolio", "photos", "albums"],
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "verturin",
			"homepage": "https://github.com/verturin",
			"role": "Lead Developer"
		}
	],
	"require": {
		"php": ">=7.2.0",
		"ext-gd": "*",
		"composer/installers": "~1.0"
	},
	"extra": {
		"display-name": "Portfolio",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.15,<5.0.0@dev"
		},
		"version-check": {
			"host": "raw.githubusercontent.com",
			"directory": "/verturin/portfolio/main",
			"filename": "version.json",
			"ssl": true
		}
	}
}
